! Languette forcée à petite amplitude (maillage mobile, ALE) : travail de l'air
! sur la languette par cycle. Positif = l'air lui donne de l'énergie.
! Paramètres MATC : A (m), f (Hz), P (Pa), t0 (début du forçage, s).
$ A = 5.0e-6
$ f = 440.0
$ P = 1000.0
$ t0 = 0.5e-3
$ dt = 1.0/f/120.0

Header
  Mesh DB "." "elmer"
  Results Directory "resultats"
End

Simulation
  Coordinate System = Cartesian 2D
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 2
  Timestep Sizes = $dt
  Timestep Intervals = 387
  Output Intervals = 0
  Steady State Max Iterations = 1
End

Constants
End

Body 1
  Equation = 1
  Material = 1
End

Material 1
  Density = 1.2
  Viscosity = 1.8e-5
  ! maillage : raideur fictive uniforme
  Youngs Modulus = 1.0
  Poisson Ratio = 0.3
End

Equation 1
  Active Solvers(4) = 1 2 3 4
End

Solver 1
  Equation = Mesh Update
  Procedure = "MeshSolve" "MeshSolver"
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End

Solver 2
  Equation = Navier-Stokes
  Procedure = "FlowSolve" "FlowSolver"
  Variable = Flow Solution[Velocity:2 Pressure:1]
  Stabilization Method = Stabilized
  Nonlinear System Max Iterations = 40
  Nonlinear System Convergence Tolerance = 1.0e-6
  Nonlinear System Newton After Iterations = 50
  Nonlinear System Relaxation Factor = 0.8
  Nonlinear System Newton After Tolerance = 1.0e-3
  Linear System Solver = Direct
  Linear System Direct Method = UMFPack
End

Solver 3
  Equation = Fluidic Force
  Procedure = "FluidicForce" "ForceCompute"
  Calculate Viscous Force = True
End

Solver 4
  Exec Solver = After Timestep
  Equation = SaveScalars
  Procedure = "SaveData" "SaveScalars"
  Filename = "force.dat"
End

Boundary Condition 1
  Target Boundaries(1) = 1
  External Pressure = Variable Time
    Real MATC "if (tx<2.0e-4) {-P*tx/2.0e-4} else {-P}"
  Mesh Update 1 = 0.0
  Mesh Update 2 = 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  External Pressure = 0.0
  Mesh Update 1 = 0.0
  Mesh Update 2 = 0.0
End

Boundary Condition 3
  Target Boundaries(1) = 3
  Velocity 1 = 0.0
  Mesh Update 1 = 0.0
End

Boundary Condition 4
  Name = "languette"
  Target Boundaries(1) = 4
  Calculate Fluidic Force = True
  Mesh Update 1 = 0.0
  Mesh Update 2 = Variable Time
    Real MATC "if (tx>t0) {A*sin(2*pi*f*(tx-t0))} else {0}"
  Velocity 1 = 0.0
  Velocity 2 = Variable Time
    Real MATC "if (tx>t0) {A*2*pi*f*cos(2*pi*f*(tx-t0))} else {0}"
End

Boundary Condition 5
  Target Boundaries(1) = 5
  Velocity 1 = 0.0
  Velocity 2 = 0.0
  Mesh Update 1 = 0.0
  Mesh Update 2 = 0.0
End
