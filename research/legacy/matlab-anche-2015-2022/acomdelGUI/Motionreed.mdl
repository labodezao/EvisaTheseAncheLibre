      script		      "function f = dilog2(u)\nN=100;\nh=(u-1)/N;\ng=zeros(1,2*N);\ng(1)=-1;\nx=zeros(1,2*N);\nx(1)=1;\n"
      "x(2)=x(1)+h;\nx(3)=x(2)+h;\ni=2;\nwhile x(i)<u\n    g(i)=log(x(i+1))/(1-x(i+1))+log(x(i))/(1-x(i));\n    x(i+2)="
      "x(i+1)+h;\n    i=i+1;\nend\n\nf=(h/2)*sum(g);"
      editorLayout	      "100 M4x1[146 214 671 364]"
    }
  }
