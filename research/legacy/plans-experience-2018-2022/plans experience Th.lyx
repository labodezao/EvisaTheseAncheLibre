\end_layout

\begin_layout Itemize
Une variation fréquentielle en fonction des qualités débit / pression sur
 tout le spectre,
\end_layout

\begin_layout Itemize
Une sensibilité 
\begin_inset Formula $\frac{\partial I}{\partial p,q}$
